        text pattern
        jsonb configuration
        integer priority
        integer version
        boolean is_active
        timestamptz created_at
        timestamptz updated_at
    }

    DOCUMENTS {
        uuid id PK
        bigint user_id FK
        bigint document_model_id FK
        varchar original_filename
        varchar stored_filename
