        text storage_path
        varchar status
        timestamptz created_at
        timestamptz updated_at
    }

    EXTRACTIONS {
        uuid id PK
        uuid document_id FK
        integer rule_version
        varchar processor
        varchar status
        numeric confidence_score
        timestamptz started_at
        timestamptz finished_at
        bigint processing_time_ms
        text error_message
        timestamptz created_at
    }

    EXTRACTED_VALUES {
        uuid id PK
        uuid extraction_id FK
        bigint field_id FK
        text raw_value
        text normalized_value
        numeric confidence_score
        integer source_page
        text source_text
        timestamptz created_at
    }

    VALIDATIONS {
        uuid id PK
        uuid extracted_value_id FK
        varchar validation_type
        varchar status
        text message
        timestamptz created_at
    }

    WORKFLOW_EVENTS {
        uuid id PK
        uuid document_id FK
        bigint user_id FK
        varchar from_status
        varchar to_status
        text comment
        timestamptz created_at
    }

    AUDIT_LOGS {
        bigint id PK
        bigint user_id FK
        uuid document_id FK
        varchar action
        varchar entity_type
        varchar entity_id
        jsonb old_value
        jsonb new_value
        inet ip_address
        timestamptz created_at
    }

    EXPORTS {
        uuid id PK
        bigint user_id FK
        varchar format
        jsonb filters
        integer record_count
        text file_path
        varchar status
        timestamptz created_at
    }
