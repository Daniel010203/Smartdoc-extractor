    PROFILES {
        bigint id PK
        varchar name UK
        varchar description
        boolean is_active
        timestamptz created_at
        timestamptz updated_at
    }

    USERS {
        bigint id PK
        bigint profile_id FK
        varchar name
        varchar email UK
        varchar password_hash
        varchar status
        timestamptz last_login_at
        timestamptz created_at
        timestamptz updated_at
    }

    DOCUMENT_MODELS {
        bigint id PK
        varchar name
        varchar code
        varchar description
        integer version
        boolean is_active
        timestamptz created_at
        timestamptz updated_at
    }

    FIELDS {
        bigint id PK
        bigint document_model_id FK
        varchar name
        varchar code
        varchar data_type
        boolean is_required
        boolean is_active
        integer display_order
        timestamptz created_at
        timestamptz updated_at
    }

    EXTRACTION_RULES {
        bigint id PK
        bigint field_id FK
        varchar name
